# The console's settings (src/env.ts says what each is), for "npm run dev" against the development
# stack. The stack itself sets them in deploy/docker-compose.dev.yml.
AGG_CONSOLE_API_URL=http://127.0.0.1:18151
AGG_ID_ISSUER=http://127.0.0.1:18372
AGG_UI_CLIENT_SECRET=dev-only-agg-ui-secret-0123456789abcd
AGG_UI_SESSION_SECRET=dev-only-agg-ui-session-secret-0123456789
AGG_CONSOLE_URL=http://localhost:13150
