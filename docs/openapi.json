{
  "openapi": "3.1.0",
  "info": {
    "title": "pacod-aggregator",
    "version": "0.1.0",
    "description": "Model data for AI gateways: the public catalogue and the console's API."
  },
  "paths": {
    "/api/v1/session": {
      "get": {
        "tags": [
          "admin"
        ],
        "summary": "Who is calling",
        "operationId": "get_api_v1_session",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "default": {
            "description": "A problem",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/status": {
      "get": {
        "tags": [
          "admin"
        ],
        "summary": "Jobs, the scraper and what is wrong",
        "operationId": "get_api_v1_status",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusView"
                }
              }
            }
          },
          "default": {
            "description": "A problem",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/runs": {
      "get": {
        "tags": [
          "runs"
        ],
        "summary": "Runs, newest first",
        "operationId": "get_api_v1_runs",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/JobRun"
                  }
                }
              }
            }
          },
          "default": {
            "description": "A problem",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "job",
            "in": "query",
            "required": false,
            "description": "check or scan; both by default.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "How many, 30 by default.",
            "schema": {
              "type": "integer"
            }
          }
        ]
      }
    },
    "/api/v1/runs/check": {
      "post": {
        "tags": [
