    "/api/v1/settings": {
      "get": {
        "tags": [
          "settings"
        ],
        "summary": "The settings",
        "operationId": "get_api_v1_settings",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SettingsView"
                }
              }
            }
          },
          "default": {
