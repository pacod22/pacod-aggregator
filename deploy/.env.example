# pacod-aggregator: copy to deploy/.env and fill in. docs/runbook.md explains each setting.

# ---------------------------------------------------------------------------------------------
# The images
# ---------------------------------------------------------------------------------------------
AGG_VERSION=0.1.0
# With a slash at the end, for example ghcr.io/pacod22/.
AGG_REGISTRY=

# ---------------------------------------------------------------------------------------------
# Listeners. The compose files set these; they matter when the binary runs without them.
# ---------------------------------------------------------------------------------------------
# The public catalogue, the admin and internal API, the metrics ("off": none).
# AGG_LISTEN=
# AGG_ADMIN_LISTEN=
# AGG_METRICS_LISTEN=
# Also set by the compose file: pacod-id's internal listener.
# AGG_ID_INTERNAL_URL=

# ---------------------------------------------------------------------------------------------
# Who may call
# ---------------------------------------------------------------------------------------------
# oidc (pacod-id) or dev (one static token, without pacod-id, for development only).
AGG_AUTH=oidc
AGG_DEV_TOKEN=
# The issuers whose tokens are taken, comma separated. The first is what browsers reach.
AGG_ID_ISSUER=
# The service client that pushes the manifest and follows the feed.
AGG_ID_CLIENT_ID=
AGG_ID_CLIENT_SECRET=
AGG_ID_AUDIENCE=
AGG_ID_MAX_STALENESS_SECONDS=
# true: the catalogue is open to anyone, without a token.
AGG_CATALOG_PUBLIC=false
# Where consumers reach the catalogue, as it says of itself.
AGG_PUBLIC_URL=

# ---------------------------------------------------------------------------------------------
# The scraper and the extraction model
# ---------------------------------------------------------------------------------------------
# What the scraper presents on the internal API. At least 16 characters.
AGG_INTERNAL_TOKEN=
# The name a scraper holds its leases under. A second scraper needs a name of its own.
AGG_SCRAPER_ID=agg-scraper
AGG_SCRAPER_PAGE_TIMEOUT_SECONDS=45
# An OpenAI-compatible endpoint, usually a pacod-gw, and its key. The model's name is a setting
# in the console. Empty: pages are fetched but not read.
AGG_LLM_URL=
AGG_LLM_KEY=
# Hosts or ranges on private networks that pages may be read from, comma separated: the server
# checks a page against it when it is saved, the scraper every connection a page makes. A page's
# scripts run in the browser, so keep it empty unless a vendor publishes on a private network.
AGG_EGRESS_ALLOW_PRIVATE=

# ---------------------------------------------------------------------------------------------
# The database
# ---------------------------------------------------------------------------------------------
# The role pacod_agg's password, part of a URL: "openssl rand -hex 24".
AGG_DB_PASSWORD=

# ---------------------------------------------------------------------------------------------
# The addresses, behind the edge (platform/caddy/agg.caddy)
# ---------------------------------------------------------------------------------------------
# The console, the public catalogue and pacod-id's pages. Caddy obtains certificates for https://
# addresses, on ports 80 and 443. AGG_ID_ISSUER above is AGG_ID_SITE's address, and the full stack
# has its own.
AGG_SITE=https://agg.example.com
AGG_API_SITE=https://agg-api.example.com
AGG_ID_SITE=https://id.example.com
# AGG_HTTP_PORT=80
# AGG_HTTPS_PORT=443
# Where people reach the console, for the sign-in's redirects: AGG_SITE's address.
AGG_CONSOLE_URL=https://agg.example.com
# The console's own client at pacod-id, and at least 32 characters that seal its session cookie.
AGG_UI_CLIENT_ID=
AGG_UI_CLIENT_SECRET=
AGG_UI_SESSION_SECRET=
AGG_CADDY_LOG_FORMAT=json

# ---------------------------------------------------------------------------------------------
# The aggregator's own stack only (docker-compose.standalone.yml). The full stack has its own.
# ---------------------------------------------------------------------------------------------
POSTGRES_PASSWORD=
PID_DB_PASSWORD=
# 32 bytes in base64: "openssl rand -base64 32".
PID_KEK=
PID_TOKEN_PEPPER=
# The first account: an identity admin and an aggregator admin.
ID_ADMIN_EMAIL=
ID_ADMIN_PASSWORD=
# Where pacod-id's mail goes: invitations and password resets. Empty: into pacod-mailpit, which
# nobody reads on a server. The sender is ID_MAIL_FROM.
PID_SMTP_HOST=
PID_SMTP_PORT=
PID_SMTP_TLS=
ID_MAIL_FROM=
# Addresses of the edge, so that pacod-id sees a person's own address behind it.
PID_TRUSTED_PROXIES=

# ---------------------------------------------------------------------------------------------
# Logs (pacod-demo/docs/LOGGING.md)
# ---------------------------------------------------------------------------------------------
# json or text.
AGG_LOG_FORMAT=json
